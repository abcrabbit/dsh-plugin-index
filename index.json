                    {
                        "name":  "dsh-plugin-screenshot-insert",
                        "title":  {
                                      "en":  "Screenshot annotate \u0026 insert",
                                      "zh":  "截屏标注插入"
                                  },
                        "description":  {
                                            "en":  "Adds a light-green screenshot button beside the composer\u0027s prompt Enhance button. Capture cross-screen regions (hiding DSH during the shot) or pick any open window, mark it with rectangles and arrows, and confirm to insert the annotated image into the composer.",
                                            "zh":  "在输入框的提示词增强按钮旁增加一个浅绿色截屏按钮：可跨屏幕区域截图（截图时自动隐藏 DSH）或从窗口列表选择任意窗口截图，加矩形/箭头标注后点“确定”才插入输入框。"
                                        },
                        "icon":  "icons/dsh-plugin-screenshot-insert.svg",
                        "author":  "bcrabbit",
                        "homepage":  "https://gitee.com/bcrabbit/dsh-plugin-screenshot-insert#readme",
